---
import { ArrowLeft } from 'lucide-astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Date Night Ideas" description="This Date Night Ideas page could not be found." canonicalPath="/404" noindex>
  <section class="not-found"><div class="shell"><span>404</span><p class="eyebrow">Wrong turn</p><h1 class="display">This date plan disappeared.</h1><p>The good news: there are still three better options waiting.</p><a class="button" href="/"><ArrowLeft size={17} /> Back to date night ideas</a></div></section>
</BaseLayout>
<style>.not-found { min-height: 75vh; padding: 100px 0; background: var(--yellow); }.not-found span { font-family: var(--display); font-size: 8rem; line-height: .8; color: var(--red); }.not-found h1 { max-width: 800px; margin: 20px 0; font-size: clamp(3.5rem, 8vw, 7rem); font-weight: 540; }.not-found p:not(.eyebrow) { margin-bottom: 28px; }</style>
