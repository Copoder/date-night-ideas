---
import { ArrowUpRight, Clock3, MapPin, WalletCards } from 'lucide-astro';
import { categoryById } from '@/data/categories';
import type { DateIdea } from '@/data/types';
import { ideaPath } from '@/lib/routes';

interface Props { idea: DateIdea; reason?: string; loading?: 'eager' | 'lazy'; }
const { idea, reason, loading = 'lazy' } = Astro.props;
const category = categoryById.get(idea.primaryCategory);
const budgetLabel = { free: 'Free', low: 'Under $30', mid: '$30–$80', high: 'Splurge' }[idea.budget];
const durationLabel = { short: 'Under 1 hour', medium: '1–3 hours', long: 'Half day+' }[idea.duration];
const locationLabel = idea.locations.includes('home') ? 'At home' : idea.locations.includes('out') ? 'Go out' : 'Either';
---

<article class="idea-card">
  <a class="idea-card__image" href={ideaPath(idea.slug)}>
    <img src={idea.image} alt={idea.imageAlt} width="720" height="480" loading={loading} />
    <span style={`--tag-color:${category?.accent ?? '#ef4e4e'}`}>{category?.shortName}</span>
  </a>
  <div class="idea-card__body">
    <div class="idea-card__meta">
      <span><WalletCards size={15} />{budgetLabel}</span>
      <span><Clock3 size={15} />{durationLabel}</span>
      <span><MapPin size={15} />{locationLabel}</span>
    </div>
    <h3><a href={ideaPath(idea.slug)}>{idea.title}</a></h3>
    <p>{idea.hook}</p>
    {reason && <div class="idea-card__reason"><strong>Why it fits</strong><span>{reason}</span></div>}
    <a class="idea-card__link" href={ideaPath(idea.slug)}>See the plan <ArrowUpRight size={17} /></a>
  </div>
</article>

<style>
  .idea-card { min-width: 0; border: 1px solid var(--ink); background: var(--paper-bright); overflow: hidden; }
  .idea-card__image { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden; background: var(--yellow); }
  .idea-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s; }
  .idea-card:hover .idea-card__image img { transform: scale(1.025); }
  .idea-card__image span { position: absolute; left: 12px; top: 12px; padding: 5px 9px; border: 1px solid var(--ink); border-radius: 3px; background: var(--tag-color); color: var(--ink); font-size: .68rem; font-weight: 850; text-transform: uppercase; }
  .idea-card__body { padding: 20px; }
  .idea-card__meta { display: flex; flex-wrap: wrap; gap: 10px 14px; color: var(--muted); font-size: .7rem; font-weight: 750; }
  .idea-card__meta span { display: inline-flex; align-items: center; gap: 4px; }
  h3 { margin: 14px 0 8px; font-family: var(--display); font-size: 1.75rem; font-weight: 620; }
  h3 a { text-decoration: none; }
  p { margin-bottom: 18px; color: var(--muted); font-size: .9rem; }
  .idea-card__reason { margin-bottom: 18px; padding: 12px 14px; border-left: 3px solid var(--red); background: #f7efe3; display: grid; gap: 3px; font-size: .78rem; }
  .idea-card__reason strong { text-transform: uppercase; font-size: .65rem; }
  .idea-card__link { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; font-weight: 850; text-decoration: none; }
  .idea-card__link:hover { text-decoration: underline; }
</style>
