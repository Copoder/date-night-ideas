---
interface Props { eyebrow: string; title: string; intro: string; }
const { eyebrow, title, intro } = Astro.props;
---

<header class="info-hero"><div class="shell"><p class="eyebrow">{eyebrow}</p><h1 class="display">{title}</h1><p>{intro}</p></div></header>
<article class="info-body shell"><slot /></article>

<style>
  .info-hero { padding: 90px 0 70px; border-bottom: 1px solid var(--ink); background: var(--mint); }
  .info-hero h1 { max-width: 900px; margin-bottom: 18px; font-size: clamp(3.4rem, 7vw, 6.8rem); font-weight: 540; }
  .info-hero p:last-child { max-width: 700px; font-size: 1.05rem; }
  .info-body { max-width: 820px; padding-block: 70px 110px; }
  .info-body :global(h2) { margin-top: 46px; margin-bottom: 14px; font-family: var(--display); font-size: 2rem; font-weight: 620; }
  .info-body :global(h3) { margin-top: 28px; }
  .info-body :global(p), .info-body :global(li) { color: #4e4c47; }
  .info-body :global(a) { font-weight: 750; }
</style>
