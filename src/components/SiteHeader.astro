---
import { Menu, X, Heart } from 'lucide-astro';
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/" aria-label="Date Night Ideas home">
      <span class="brand__mark"><Heart size={18} stroke-width={2.4} /></span>
      <span>Date Night Ideas</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation" data-site-nav data-open="false">
      <a href="/#picker">Pick a date</a>
      <a href="/categories/">Browse ideas</a>
      <a href="/cheap-date-night-ideas/">Cheap</a>
      <a href="/at-home-date-night-ideas/">At home</a>
      <a href="/unique-date-ideas/">Unique</a>
    </nav>
    <button class="icon-button nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-nav-toggle>
      <Menu class="nav-open" size={22} />
      <X class="nav-close" size={22} />
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    nav?.setAttribute('data-open', String(!open));
  });
</script>
